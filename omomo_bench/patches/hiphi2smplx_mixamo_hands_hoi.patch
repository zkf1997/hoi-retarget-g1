@@ -0,0 +1,228 @@
+"""Joint SMPL-X shape, body-pose and finger-pose fitting on a few BVH frames.
+
+SMPL-X has no separate hand shape space: hands share the unified ``shapedirs``
+basis with the body. To make the fitted shape respect the actor's hands, this
+module fits ``num_betas`` shape coefficients together with per-frame body and
+finger poses against the 22 body joints, the 30 finger joints and the 10
+fingertip End Sites of several frames spread over the clip. Unlike
+``beta_fitting`` it needs no SMPLify resources: body poses are initialised from
+the BVH rotations and regularised towards them.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from .beta_fitting import _prepare_target_joints
+from .hoi_refine import DIGITS, _hand_point_layout, _rodrigues, load_bvh_targets
+from .skeleton import MotionClip
+
+
+@dataclass(frozen=True)
+class ShapeFitConfig:
+    """Settings for joint shape + hand fitting (positions in cm, angles in rad).
+
+    Attributes:
+        num_betas: Number of SMPL-X shape coefficients to fit (max 300).
+        num_frames: Frames spread evenly over the clip used for the fit.
+        iterations: Adam iterations.
+        lr: Adam learning rate.
+        device: Torch device.
+        w_body: Weight of the squared 22-joint position error.
+        w_hand: Weight of the squared finger joint / fingertip position error.
+        w_hand_dir: Weight of the finger bone direction error.
+        w_shape_prior: L2 prior on the first 10 shape coefficients.
+        w_shape_prior_extra: L2 prior on coefficients beyond the first 10.
+        w_pose_prior: L2 pull of body rotations towards the BVH reference rotations.
+        w_hand_prior: L2 prior on finger rotations.
+    """
+
+    num_betas: int = 16
+    num_frames: int = 8
+    iterations: int = 400
+    lr: float = 0.02
+    device: str = "cuda:0"
+    w_body: float = 1.0
+    w_hand: float = 1.0
+    w_hand_dir: float = 20.0
+    w_shape_prior: float = 0.5
+    w_shape_prior_extra: float = 3.0
+    w_pose_prior: float = 0.5
+    w_hand_prior: float = 0.05
+
+
+@dataclass(frozen=True)
+class ShapeFitResult:
+    """Fitted shape and diagnostics."""
+
+    betas: np.ndarray
+    body_error_cm: float
+    hand_error_cm: float
+    hand_error_cm_initial: float
+    hand_bone_ratio: np.ndarray  # (2, 20) SMPL-X / BVH bone length after fitting
+
+
+class _ShapeModel:
+    """SMPL-X joints plus fingertip vertices as a differentiable function of betas and pose."""
+
+    def __init__(self, model_path: Path, num_betas: int, tip_ids: list[int], device: torch.device) -> None:
+        with np.load(model_path, allow_pickle=True) as m:
+            v_template = np.asarray(m["v_template"], dtype=np.float32)
+            shapedirs = np.asarray(m["shapedirs"], dtype=np.float32)
+            posedirs = np.asarray(m["posedirs"], dtype=np.float32)
+            weights = np.asarray(m["weights"], dtype=np.float32)
+            regressor = m["J_regressor"]
+            if hasattr(regressor, "toarray"):
+                regressor = regressor.toarray()
+            parents = np.asarray(m["kintree_table"], dtype=np.int64)[0].copy()
+        parents[0] = -1
+        max_betas = shapedirs.shape[-1] - 100  # last 100 columns are expressions
+        if not 1 <= num_betas <= max_betas:
+            raise ValueError(f"num_betas must be in [1, {max_betas}]")
+        self.parents = parents
+        self.num_joints = len(parents)
+        self.tip_ids = torch.as_tensor(tip_ids, device=device)
+        self.v_template = torch.as_tensor(v_template, device=device)
+        self.shapedirs = torch.as_tensor(shapedirs[..., :num_betas].reshape(-1, num_betas), device=device)
+        self.regressor = torch.as_tensor(np.asarray(regressor, dtype=np.float32), device=device)
+        self.tip_posedirs = torch.as_tensor(posedirs[tip_ids].reshape(-1, posedirs.shape[-1]).T.copy(), device=device)
+        self.tip_weights = torch.as_tensor(weights[tip_ids], device=device)
+
+    def forward(self, betas: torch.Tensor, pose: torch.Tensor, trans: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        """Return posed joints ``(K, 55, 3)`` and fingertip vertices ``(K, 10, 3)``."""
+        k = pose.shape[0]
+        v_shaped = self.v_template + (self.shapedirs @ betas).reshape(-1, 3)
+        rest = self.regressor @ v_shaped  # (55, 3)
+        rel = rest.clone()
+        rel[1:] = rest[1:] - rest[self.parents[1:]]
+        rot = _rodrigues(pose)
+        rots = [rot[:, 0]]
+        pos = [rel[0].expand(k, 3)]
+        for j in range(1, self.num_joints):
+            p = self.parents[j]
+            rots.append(rots[p] @ rot[:, j])
+            pos.append(pos[p] + (rots[p] @ rel[j]))
+        g_rot = torch.stack(rots, 1)
+        joints = torch.stack(pos, 1)
+        skin_t = joints - (g_rot @ rest[None, :, :, None])[..., 0]
+        eye = torch.eye(3, device=pose.device)
+        feature = (rot[:, 1:] - eye).reshape(k, -1)
+        tips_rest = v_shaped[self.tip_ids][None] + (feature @ self.tip_posedirs).reshape(k, -1, 3)
+        blend = torch.matmul(self.tip_weights, torch.cat([g_rot.reshape(k, self.num_joints, 9), skin_t], -1))
+        tips = (blend[..., :9].reshape(k, -1, 3, 3) * tips_rest[..., None, :]).sum(-1) + blend[..., 9:]
+        return joints + trans[:, None], tips + trans[:, None]
+
+
+def fit_shape_and_hands(
+    source: MotionClip,
+    bvh_path: Path,
+    body_targets: np.ndarray,
+    reference_pose: np.ndarray,
+    neutral_rest_joints: np.ndarray,
+    model_path: Path,
+    config: ShapeFitConfig | None = None,
+    skeleton_map: str = "hiphi",
+) -> ShapeFitResult:
+    """Fit shape coefficients jointly with body and finger poses.
+
+    Args:
+        source: Parsed BVH clip.
+        bvh_path: BVH path (re-read for End Site fingertips).
+        body_targets: Mapped 22-joint targets ``(F, 22, 3)`` from ``prepare_body_inputs``.
+        reference_pose: Copied local body rotations ``(F, 22, 3)``.
+        neutral_rest_joints: Neutral 22 rest joints used for the foot correction.
+        model_path: SMPL-X NPZ.
+        config: Fitting settings.
+
+    Returns:
+        Fitted betas and error diagnostics.
+    """
+    cfg = ShapeFitConfig() if config is None else config
+    dev = torch.device(cfg.device)
+    if dev.type == "cuda" and not torch.cuda.is_available():
+        dev = torch.device("cpu")
+    num_frames = len(body_targets)
+    k = min(cfg.num_frames, num_frames)
+    frames = np.unique(np.linspace(0, num_frames - 1, k).round().astype(int))
+    k = len(frames)
+
+    targets = load_bvh_targets(bvh_path, clip=source, skeleton_map=skeleton_map)
+    layouts = {s: _hand_point_layout(s) for s in ("left", "right")}
+    tip_ids = layouts["left"][1] + layouts["right"][1]
+    model = _ShapeModel(model_path, cfg.num_betas, tip_ids, dev)
+
+    body_t = np.stack([_prepare_target_joints(body_targets[f], neutral_rest_joints) for f in frames])
+    body_t = torch.as_tensor(body_t, device=dev)
+    hand_t = {s: torch.as_tensor(targets.hands[s][frames], device=dev) for s in layouts}
+    hand_rows = {s: torch.as_tensor(layouts[s][0], device=dev) for s in layouts}
+    tip_cols = {"left": torch.arange(0, 5, device=dev), "right": torch.arange(5, 10, device=dev)}
+    bones = {s: torch.as_tensor(layouts[s][2], device=dev) for s in layouts}
+
+    betas = torch.zeros(cfg.num_betas, device=dev, requires_grad=True)
+    ref = torch.as_tensor(reference_pose[frames], device=dev)  # (k, 22, 3)
+    orient = ref[:, 0].clone().requires_grad_(True)
+    body = ref[:, 1:22].clone().requires_grad_(True)
+    hands = torch.zeros(k, 30, 3, device=dev, requires_grad=True)
+    with torch.no_grad():
+        j0, _ = model.forward(betas, _assemble(orient, body, hands), torch.zeros(k, 3, device=dev))
+    trans = (body_t[:, 0] - j0[:, 0]).clone().requires_grad_(True)
+
+    def hand_points(joints, tips, side):
+        return torch.cat([joints[:, hand_rows[side]], tips[:, tip_cols[side]]], 1)  # (k, 21, 3)
+
+    def hand_error(joints, tips):
+        errs = [((hand_points(joints, tips, s)[:, 1:] - hand_t[s][:, 1:]).norm(dim=-1)) for s in layouts]
+        return torch.cat(errs, 1).mean() * 100.0
+
+    with torch.no_grad():
+        j, t = model.forward(betas, _assemble(orient, body, hands), trans)
+        hand_err_init = float(hand_error(j, t))
+
+    opt = torch.optim.Adam([betas, orient, body, hands, trans], lr=cfg.lr)
+    for _ in range(cfg.iterations):
+        opt.zero_grad(set_to_none=True)
+        joints, tips = model.forward(betas, _assemble(orient, body, hands), trans)
+        loss = cfg.w_body * ((joints[:, :22] - body_t) * 100.0).pow(2).sum(-1).sum(-1).mean()
+        for s in layouts:
+            pts = hand_points(joints, tips, s)
+            tgt = hand_t[s]
+            b = bones[s]
+            loss = loss + cfg.w_hand * ((pts[:, 1:] - tgt[:, 1:]) * 100.0).pow(2).sum(-1).sum(-1).mean()
+            u_s = F.normalize(pts[:, b[:, 1]] - pts[:, b[:, 0]], dim=-1)
+            u_t = F.normalize(tgt[:, b[:, 1]] - tgt[:, b[:, 0]], dim=-1)
+            loss = loss + cfg.w_hand_dir * (u_s - u_t).pow(2).sum(-1).sum(-1).mean()
+        loss = loss + cfg.w_shape_prior * betas[:10].pow(2).sum() + cfg.w_shape_prior_extra * betas[10:].pow(2).sum()
+        loss = loss + cfg.w_pose_prior * ((body - ref[:, 1:22]).pow(2).sum() + (orient - ref[:, 0]).pow(2).sum()) / k
+        loss = loss + cfg.w_hand_prior * hands.pow(2).sum() / k
+        loss.backward()
+        opt.step()
+
+    with torch.no_grad():
+        joints, tips = model.forward(betas, _assemble(orient, body, hands), trans)
+        body_err = float((joints[:, :22] - body_t).norm(dim=-1).mean() * 100.0)
+        hand_err = float(hand_error(joints, tips))
+        ratios = []
+        for s in layouts:
+            pts = hand_points(joints, tips, s)
+            tgt = hand_t[s]
+            b = bones[s]
+            len_s = (pts[:, b[:, 1]] - pts[:, b[:, 0]]).norm(dim=-1).mean(0)
+            len_t = (tgt[:, b[:, 1]] - tgt[:, b[:, 0]]).norm(dim=-1).mean(0)
+            ratios.append((len_s / len_t).cpu().numpy())
+    return ShapeFitResult(
+        betas=betas.detach().cpu().numpy().astype(np.float32),
+        body_error_cm=body_err,
+        hand_error_cm=hand_err,
+        hand_error_cm_initial=hand_err_init,
+        hand_bone_ratio=np.stack(ratios),
+    )
+
+
+def _assemble(orient: torch.Tensor, body: torch.Tensor, hands: torch.Tensor) -> torch.Tensor:
+    k = orient.shape[0]
+    return torch.cat([orient[:, None], body, torch.zeros(k, 3, 3, device=orient.device), hands], 1)
