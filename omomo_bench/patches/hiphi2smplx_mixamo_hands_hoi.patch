@@ -0,0 +1,774 @@
+"""Stage-2 HOI refinement: SMPL-X finger fitting plus object penetration/contact terms.
+
+The stage-1 pipeline (``fit_bvh``) solves the 22 body joints with Mink IK and
+leaves the fingers at zero. This module takes that result and, in batched GPU
+optimisation over sliding frame chunks, refines
+
+* both hands (SMPL-X ``left_hand_pose``/``right_hand_pose``) against the 30
+  HiPHI finger joints and 10 End-Site fingertips of the BVH,
+* body pose and translation, anchored to the stage-1 joints, so that a
+  signed-distance penetration penalty and a contact attraction term against
+  the tracked object mesh can be satisfied.
+
+The object mesh SDF is computed once per mesh with libigl (fast winding-number
+sign, robust for non-watertight OBJs) on a regular grid in object-local
+centimetres and sampled with trilinear interpolation.
+"""
+
+from __future__ import annotations
+
+import csv
+import json
+import time
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+from scipy.spatial.transform import Rotation
+
+from .bvh import load_bvh
+from .skeleton import BODY_SEMANTICS, HIPHI_MAP, SMPLX_JOINT_NAMES, SOURCE_SKELETON_MAPS, MotionClip
+
+# --------------------------------------------------------------------------- #
+# Constants
+# --------------------------------------------------------------------------- #
+
+DIGITS = ("thumb", "index", "middle", "ring", "pinky")
+_BVH_DIGIT = {"thumb": "Thumb", "index": "Index", "middle": "Middle", "ring": "Ring", "pinky": "Pinky"}
+_BVH_SIDE = {"left": "Left", "right": "Right"}
+_WRIST_INDEX = {"left": 20, "right": 21}
+# SMPL-X fingertip vertices (smplx.vertex_ids['smplx']).
+_TIP_VERTEX = {
+    "left": {"thumb": 5361, "index": 4933, "middle": 5058, "ring": 5169, "pinky": 5286},
+    "right": {"thumb": 8079, "index": 7669, "middle": 7794, "ring": 7905, "pinky": 8022},
+}
+_JOINT_INDEX = {name: i for i, name in enumerate(SMPLX_JOINT_NAMES)}
+
+
+def _hand_joint_names(side: str) -> list[str]:
+    """Return the 15 SMPL-X finger joint names of one side in SMPL-X order."""
+    return [n for n in SMPLX_JOINT_NAMES[25:55] if n.startswith(f"{side}_")]
+
+
+def _hand_point_layout(side: str) -> tuple[list[int], list[int], list[tuple[int, int]]]:
+    """Describe the 21-point hand layout: wrist, 15 joints, 5 tips.
+
+    Returns:
+        SMPL-X joint indices for points 0..15, tip vertex ids for points
+        16..20 (thumb, index, middle, ring, pinky), and the 20 (parent, child)
+        bone pairs inside the 21-point array.
+    """
+    names = _hand_joint_names(side)
+    joint_ids = [_WRIST_INDEX[side]] + [_JOINT_INDEX[n] for n in names]
+    tip_ids = [_TIP_VERTEX[side][d] for d in DIGITS]
+    local = {n: i + 1 for i, n in enumerate(names)}
+    bones = []
+    for k, d in enumerate(DIGITS):
+        chain = [0] + [local[f"{side}_{d}{s}"] for s in (1, 2, 3)] + [16 + k]
+        bones += list(zip(chain[:-1], chain[1:], strict=True))
+    return joint_ids, tip_ids, bones
+
+
+# --------------------------------------------------------------------------- #
+# BVH targets
+# --------------------------------------------------------------------------- #
+
+
+def _parse_end_sites(path: Path, unit_scale: float) -> dict[str, np.ndarray]:
+    """Return End Site offsets keyed by their parent joint name."""
+    sites: dict[str, np.ndarray] = {}
+    current = None
+    in_site = False
+    for raw in path.read_text(encoding="utf-8", errors="ignore").splitlines():
+        line = raw.strip()
+        if line == "MOTION":
+            break
+        if line.startswith(("ROOT ", "JOINT ")):
+            current = line.split(maxsplit=1)[1].strip()
+            in_site = False
+        elif line.startswith("End Site"):
+            in_site = True
+        elif line.startswith("OFFSET ") and in_site and current is not None:
+            sites[current] = np.asarray(line.split()[1:4], dtype=np.float32) * unit_scale
+            in_site = False
+    return sites
+
+
+@dataclass
+class BvhTargets:
+    """World-space BVH hand targets and body joints in metres."""
+
+    frame_time: float
+    body: np.ndarray  # (F, 22, 3)
+    hands: dict[str, np.ndarray]  # side -> (F, 21, 3): wrist, 15 joints, 5 tips
+    hand_scale: dict[str, float] = field(default_factory=dict)
+
+
+def load_bvh_targets(bvh_path: Path, clip: MotionClip | None = None, skeleton_map: str = "hiphi") -> BvhTargets:
+    """Compute world-space body/finger/tip positions from a HiPHI-style BVH (body joints via ``skeleton_map``)."""
+    body_map = SOURCE_SKELETON_MAPS[skeleton_map]
+    if clip is None:
+        clip = load_bvh(bvh_path, unit_scale=0.01)
+    positions, rotations = clip.world_transforms()
+    index = {n: i for i, n in enumerate(clip.skeleton.joint_names)}
+    sites = _parse_end_sites(bvh_path, 0.01)
+    body = positions[:, [index[body_map[s]] for s in BODY_SEMANTICS]]
+    hands = {}
+    for side in ("left", "right"):
+        pts = [positions[:, index[f"{_BVH_SIDE[side]}Hand"]]]
+        for n in _hand_joint_names(side):
+            digit, seg = n[len(side) + 1 : -1], n[-1]
+            pts.append(positions[:, index[f"{_BVH_SIDE[side]}Hand{_BVH_DIGIT[digit]}{seg}"]])
+        for d in DIGITS:
+            j = f"{_BVH_SIDE[side]}Hand{_BVH_DIGIT[d]}3"
+            off = sites.get(j)
+            if off is None:
+                raise ValueError(f"{bvh_path}: missing End Site under {j}")
+            pts.append(positions[:, index[j]] + np.einsum("fij,j->fi", rotations[:, index[j]], off))
+        hands[side] = np.stack(pts, axis=1).astype(np.float32)
+    return BvhTargets(float(clip.frame_time), body.astype(np.float32), hands)
+
+
+# --------------------------------------------------------------------------- #
+# Light SMPL-X layer on a vertex subset
+# --------------------------------------------------------------------------- #
+
+
+def _rodrigues(rv: torch.Tensor) -> torch.Tensor:
+    """Axis-angle ``(..., 3)`` to rotation matrices ``(..., 3, 3)``."""
+    angle = torch.norm(rv + 1e-9, dim=-1, keepdim=True)
+    axis = rv / angle
+    cos = torch.cos(angle)[..., None]
+    sin = torch.sin(angle)[..., None]
+    x, y, z = axis.unbind(-1)
+    zero = torch.zeros_like(x)
+    k = torch.stack([zero, -z, y, z, zero, -x, -y, x, zero], dim=-1).reshape(*rv.shape[:-1], 3, 3)
+    eye = torch.eye(3, device=rv.device, dtype=rv.dtype)
+    return eye + sin * k + (1.0 - cos) * (k @ k)
+
+
+class SmplxLite:
+    """Fixed-shape SMPL-X forward pass restricted to a vertex subset."""
+
+    def __init__(
+        self,
+        model_path: Path,
+        betas: np.ndarray,
+        vertex_ids: np.ndarray,
+        device: torch.device,
+    ) -> None:
+        with np.load(model_path, allow_pickle=True) as m:
+            v_template = np.asarray(m["v_template"], dtype=np.float64)
+            shapedirs = np.asarray(m["shapedirs"], dtype=np.float64)
+            posedirs = np.asarray(m["posedirs"], dtype=np.float64)
+            weights = np.asarray(m["weights"], dtype=np.float64)
+            regressor = m["J_regressor"]
+            if hasattr(regressor, "toarray"):
+                regressor = regressor.toarray()
+            parents = np.asarray(m["kintree_table"], dtype=np.int64)[0].copy()
+        parents[0] = -1
+        b = np.asarray(betas, dtype=np.float64).reshape(-1)
+        v_shaped = v_template + np.einsum("vcn,n->vc", shapedirs[..., : b.size], b)
+        joints = np.asarray(regressor, dtype=np.float64) @ v_shaped
+        self.num_joints = joints.shape[0]
+        self.parents = parents
+        self.vertex_ids = np.asarray(vertex_ids, dtype=np.int64)
+        self.device = device
+        dt = torch.float32
+        self.rest_joints = torch.as_tensor(joints, dtype=dt, device=device)
+        self.v_shaped = torch.as_tensor(v_shaped[self.vertex_ids], dtype=dt, device=device)
+        pd = posedirs[self.vertex_ids].reshape(-1, posedirs.shape[-1]).T  # (486, Vs*3)
+        self.posedirs = torch.as_tensor(np.ascontiguousarray(pd), dtype=dt, device=device)
+        self.weights = torch.as_tensor(weights[self.vertex_ids], dtype=dt, device=device)
+        self.weights_full = weights
+        rel = joints.copy()
+        rel[1:] -= joints[parents[1:]]
+        self.rel_joints = torch.as_tensor(rel, dtype=dt, device=device)
+        with np.load(model_path, allow_pickle=True) as m:
+            faces = np.asarray(m["f"], dtype=np.int64)
+        import trimesh
+
+        normals = trimesh.Trimesh(v_shaped, faces, process=False).vertex_normals
+        self.rest_normals = torch.as_tensor(np.asarray(normals)[self.vertex_ids], dtype=dt, device=device)
+
+    def forward(self, pose: torch.Tensor, trans: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        """Pose ``(B, 55, 3)`` axis-angle and ``(B, 3)`` translation to joints and subset verts."""
+        joints, verts, _ = self.forward_with_normals(pose, trans)
+        return joints, verts
+
+    def rigid_transforms(
+        self, pose: torch.Tensor
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+        """Return local rotations, global rotations, posed joints and skinning translations.
+
+        The skinning transform of joint ``j`` maps rest-pose vertices to posed
+        vertices as ``v' = g_rot[j] @ v + skin_t[j]`` (before the root translation).
+        """
+        batch = pose.shape[0]
+        rot = _rodrigues(pose)  # (B, 55, 3, 3)
+        rel = self.rel_joints
+        rots = [rot[:, 0]]
+        pos = [rel[0].expand(batch, 3)]
+        for j in range(1, self.num_joints):
+            parent = self.parents[j]
+            rots.append(rots[parent] @ rot[:, j])
+            pos.append(pos[parent] + (rots[parent] @ rel[j]))
+        g_rot = torch.stack(rots, dim=1)  # (B, J, 3, 3)
+        joints = torch.stack(pos, dim=1)  # (B, J, 3)
+        skin_t = joints - (g_rot @ self.rest_joints[None, :, :, None])[..., 0]  # (B, J, 3)
+        return rot, g_rot, joints, skin_t
+
+    def forward_with_normals(
+        self, pose: torch.Tensor, trans: torch.Tensor
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        """Like :meth:`forward` but also returns approximate posed vertex normals ``(B, Vs, 3)``."""
+        batch = pose.shape[0]
+        rot, g_rot, joints, skin_t = self.rigid_transforms(pose)
+        eye = torch.eye(3, device=pose.device, dtype=pose.dtype)
+        feature = (rot[:, 1:] - eye).reshape(batch, -1)
+        v_posed = self.v_shaped[None] + (feature @ self.posedirs).reshape(batch, -1, 3)
+
+        # Linear blend skinning as one GEMM: (Vs, J) @ (B, J, 12) -> (B, Vs, 12).
+        blend = torch.matmul(self.weights, torch.cat([g_rot.reshape(batch, self.num_joints, 9), skin_t], dim=-1))
+        v_rot = blend[..., :9].reshape(batch, -1, 3, 3)
+        verts = (v_rot * v_posed[..., None, :]).sum(-1) + blend[..., 9:]
+        normals = F.normalize((v_rot * self.rest_normals[None, :, None, :]).sum(-1), dim=-1)
+        return joints + trans[:, None], verts + trans[:, None], normals
+
+
+# --------------------------------------------------------------------------- #
+# Object SDF
+# --------------------------------------------------------------------------- #
+
+
+class ObjectSDF:
+    """Grid signed-distance field (centimetres, object-local) with trilinear sampling."""
+
+    def __init__(
+        self,
+        mesh_path: Path,
+        device: torch.device,
+        cache_dir: Path | None = None,
+        cell_cm: float = 1.0,
+        pad_cm: float = 15.0,
+        max_res: int = 224,
+    ) -> None:
+        cache = None if cache_dir is None else cache_dir / f"{mesh_path.stem}_sdf.npz"
+        if cache is not None and cache.exists():
+            with np.load(cache) as d:
+                origin, spacing, sdf = d["origin"], d["spacing"], d["sdf"]
+        else:
+            origin, spacing, sdf = self._compute(mesh_path, cell_cm, pad_cm, max_res)
+            if cache is not None:
+                cache.parent.mkdir(parents=True, exist_ok=True)
+                tmp = cache.with_suffix(".tmp.npz")
+                np.savez_compressed(tmp, origin=origin, spacing=spacing, sdf=sdf)
+                tmp.replace(cache)
+        self.origin = torch.as_tensor(origin, dtype=torch.float32, device=device)
+        self.extent = torch.as_tensor(spacing * (np.asarray(sdf.shape) - 1), dtype=torch.float32, device=device)
+        self.grid = torch.as_tensor(sdf, dtype=torch.float32, device=device)[None, None]
+        self.min_sdf = float(sdf.min())
+
+    @staticmethod
+    def _compute(mesh_path: Path, cell_cm: float, pad_cm: float, max_res: int) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+        import igl
+        import trimesh
+
+        mesh = trimesh.load(mesh_path, force="mesh", process=True, skip_materials=True)
+        mesh.merge_vertices(merge_tex=True, merge_norm=True)
+        verts = np.asarray(mesh.vertices, dtype=np.float64)
+        faces = np.asarray(mesh.faces, dtype=np.int64)
+        lo = verts.min(0) - pad_cm
+        hi = verts.max(0) + pad_cm
+        res = np.minimum(np.ceil((hi - lo) / cell_cm).astype(int) + 1, max_res)
+        axes = [np.linspace(lo[i], hi[i], res[i]) for i in range(3)]
+        spacing = np.asarray([(hi[i] - lo[i]) / (res[i] - 1) for i in range(3)])
+        query = np.stack(np.meshgrid(*axes, indexing="ij"), axis=-1).reshape(-1, 3)
+        sdf, _, _, _ = igl.signed_distance(query, verts, faces, igl.SIGNED_DISTANCE_TYPE_FAST_WINDING_NUMBER)
+        return lo.astype(np.float32), spacing.astype(np.float32), sdf.reshape(*res).astype(np.float32)
+
+    def query(self, points_cm: torch.Tensor) -> torch.Tensor:
+        """Sample the SDF at object-local points ``(..., 3)`` in centimetres."""
+        shape = points_cm.shape[:-1]
+        norm = (points_cm.reshape(-1, 3) - self.origin) / self.extent * 2.0 - 1.0
+        coords = norm[:, [2, 1, 0]].reshape(1, 1, 1, -1, 3)
+        out = F.grid_sample(self.grid, coords, mode="bilinear", padding_mode="border", align_corners=True)
+        return out.reshape(shape)
+
+
+@dataclass
+class TrackedObject:
+    """One object's SDF and per-frame world pose."""
+
+    object_id: str
+    category: str
+    sdf: ObjectSDF
+    position: torch.Tensor  # (F, 3) metres
+    rotation: torch.Tensor  # (F, 3, 3) local->world
+
+    def to_local_cm(self, points_world: torch.Tensor, frames: slice) -> torch.Tensor:
+        """World points ``(B, N, 3)`` in metres to object-local centimetres."""
+        rot = self.rotation[frames]
+        pos = self.position[frames]
+        return torch.einsum("bni,bij->bnj", points_world - pos[:, None], rot) * 100.0
+
+
+def load_objects(package: Path, repo_root: Path, device: torch.device, cache_dir: Path | None) -> list[TrackedObject]:
+    """Load every tracked object of one HiPHI package."""
+    meta = json.loads((package / "metadata.json").read_text())
+    objects = []
+    for obj in meta.get("objects", []):
+        rows = list(csv.DictReader((package / obj["trajectory_path"]).open()))
+        pos = np.asarray([[r["px"], r["py"], r["pz"]] for r in rows], dtype=np.float64)
+        quat = np.asarray([[r["qx"], r["qy"], r["qz"], r["qw"]] for r in rows], dtype=np.float64)
+        rot = Rotation.from_quat(quat).as_matrix()
+        objects.append(
+            TrackedObject(
+                object_id=obj["object_id"],
+                category=obj["object_category"],
+                sdf=ObjectSDF(repo_root / obj["mesh_path"], device, cache_dir),
+                position=torch.as_tensor(pos, dtype=torch.float32, device=device),
+                rotation=torch.as_tensor(rot, dtype=torch.float32, device=device),
+            )
+        )
+    return objects
+
+
+# --------------------------------------------------------------------------- #
+# Refinement
+# --------------------------------------------------------------------------- #
+
+
+@dataclass(frozen=True)
+class RefineConfig:
+    """Weights and schedule for stage-2 refinement (positions in cm, angles in rad).
+
+    ``body_mode`` limits which stage-1 parameters may be corrected: ``"arms"``
+    frees only shoulders, elbows, wrists and fingers (pelvis, spine, neck, head,
+    legs and the global translation stay exactly at stage 1); ``"all"`` frees
+    everything (needed when the torso/legs themselves interact with the object,
+    e.g. sitting); ``"auto"`` picks ``"all"`` when more than ``body_contact_frac``
+    of the frames show non-hand body vertices penetrating deeper than 1 cm.
+
+    The refinement optimises a *low-frequency correction* on top of the stage-1
+    parameters: every parameter delta is a cubic B-spline in time with knots
+    every ``basis_spacing`` frames (9 frames = 10 Hz at 90 Hz), so the
+    corrections cannot introduce frame-to-frame jitter by construction. All
+    chunks share one coefficient set (gradients are accumulated over chunks)
+    and Adam uses a cosine learning-rate decay to ``lr_final_ratio``.
+    Hands are initialised from the stage-1 poses (``--fit-hands``) and pulled
+    back to them by ``w_hand_prior``. ``w_corr_accel`` penalises the second time-difference of the correction (refined minus stage-1 joint positions, cm) so corrections vary slowly instead of oscillating with the contact state. ``w_accel`` optionally adds a second-
+    difference penalty on joint positions; ``contact_filter_frames``
+    majority-filters the BVH tip contact flags in time. ``iters_hand`` is kept
+    for CLI compatibility and ignored.
+    """
+
+    chunk: int = 2048
+    iters_hand: int = 0
+    iters_full: int = 120
+    lr_hand: float = 0.05
+    lr_full: float = 0.01
+    w_joint_anchor: float = 1.0
+    w_pose_prior: float = 1.0
+    body_mode: str = "auto"
+    body_contact_frac: float = 0.1
+    w_hand_dir: float = 50.0
+    w_hand_pos: float = 0.5
+    w_hand_prior: float = 1.0
+    w_hand_pca: float = 0.0
+    w_smooth_pose: float = 5.0
+    w_smooth_trans: float = 1.0
+    w_accel: float = 0.0
+    w_corr_accel: float = 0.0
+    contact_filter_frames: int = 9
+    basis_spacing: int = 9
+    lr_final_ratio: float = 0.05
+    w_pen: float = 1.0
+    w_pen_normal: float = 0.0
+    pen_margin_cm: float = 0.5
+    w_contact_tip: float = 0.5
+    w_contact_body: float = 0.1
+    contact_tip_cm: float = 2.0
+    contact_band_cm: float = 2.0
+    contact_target_cm: float = 0.3
+    body_subsample: int = 3
+
+
+def _select_vertices(weights: np.ndarray, body_subsample: int) -> tuple[np.ndarray, dict[str, Any]]:
+    """Choose the SMPL-X vertex subset: all hand vertices plus a body subsample."""
+    dominant = weights.argmax(axis=1)
+    hand_mask = (dominant >= 25) | (dominant == 20) | (dominant == 21)
+    body_ids = np.flatnonzero(~hand_mask)[::body_subsample]
+    ids = np.unique(np.concatenate([np.flatnonzero(hand_mask), body_ids, np.asarray(
+        [v for side in _TIP_VERTEX.values() for v in side.values()])]))
+    lookup = {v: i for i, v in enumerate(ids)}
+    info = {
+        "lookup": lookup,
+        "hand_mask": hand_mask[ids],
+        # vertices dominated by each distal phalanx joint, used for tip contact
+        "digit3": {
+            side: {d: np.asarray([lookup[v] for v in np.flatnonzero(dominant == _JOINT_INDEX[f"{side}_{d}3"])
+                                  if v in lookup]) for d in DIGITS}
+            for side in ("left", "right")
+        },
+    }
+    return ids, info
+
+
+def _accel(x: torch.Tensor, prev1: torch.Tensor | None, prev2: torch.Tensor | None) -> torch.Tensor:
+    """Sum of squared second differences, chained to the two previous frames when given."""
+    if prev1 is not None and prev2 is not None:
+        x = torch.cat([prev2[None], prev1[None], x], dim=0)
+    elif prev1 is not None:
+        x = torch.cat([prev1[None], x], dim=0)
+    return (x[2:] - 2 * x[1:-1] + x[:-2]).pow(2).sum()
+
+
+def _smooth(x: torch.Tensor, prev: torch.Tensor | None) -> torch.Tensor:
+    """Sum of squared frame-to-frame differences, optionally chained to a previous frame."""
+    diff = (x[1:] - x[:-1]).pow(2).sum()
+    if prev is not None:
+        diff = diff + (x[0] - prev).pow(2).sum()
+    return diff
+
+
+def _bspline_basis(num_frames: int, spacing: int, device: torch.device) -> torch.Tensor:
+    """Dense cubic B-spline design matrix ``(F, K)`` with uniform knots every ``spacing`` frames."""
+    from scipy.interpolate import BSpline
+
+    spacing = max(1, min(spacing, max(1, num_frames - 1)))
+    inner = np.arange(0, num_frames - 1 + spacing, spacing, dtype=np.float64)
+    inner[-1] = max(inner[-1], num_frames - 1)
+    knots = np.concatenate([[inner[0]] * 3, inner, [inner[-1]] * 3])
+    t = np.arange(num_frames, dtype=np.float64)
+    basis = BSpline.design_matrix(t, knots, 3).toarray()
+    return torch.as_tensor(basis, dtype=torch.float32, device=device)
+
+
+def refine_package(
+    package: Path,
+    stage1_npz: Path,
+    model_path: Path,
+    repo_root: Path,
+    output: Path,
+    *,
+    config: RefineConfig | None = None,
+    device: str = "cuda:0",
+    sdf_cache: Path | None = None,
+    stats_path: Path | None = None,
+    progress: bool = False,
+) -> dict[str, Any]:
+    """Refine one stage-1 SMPL-X motion with hand and object HOI terms (low-frequency correction)."""
+    cfg = RefineConfig() if config is None else config
+    dev = torch.device(device)
+    t_start = time.time()
+
+    with np.load(stage1_npz) as d:
+        poses0 = np.asarray(d["poses"], dtype=np.float32).reshape(-1, 55, 3)
+        trans0 = np.asarray(d["trans"], dtype=np.float32)
+        betas = np.asarray(d["betas"], dtype=np.float32)
+        framerate = float(d["mocap_framerate"])
+    targets = load_bvh_targets(package / "motion_actor.bvh")
+    num_frames = min(len(poses0), len(targets.body))
+    poses0, trans0 = poses0[:num_frames], trans0[:num_frames]
+
+    with np.load(model_path, allow_pickle=True) as m:
+        weights_full = np.asarray(m["weights"])
+    vertex_ids, vinfo = _select_vertices(weights_full, cfg.body_subsample)
+    model = SmplxLite(model_path, betas, vertex_ids, dev)
+    objects = load_objects(package, repo_root, dev, sdf_cache)
+    for obj in objects:
+        if len(obj.position) < num_frames:
+            raise ValueError(f"{obj.object_id}: trajectory shorter than motion")
+
+    layouts = {s: _hand_point_layout(s) for s in ("left", "right")}
+    tip_rows = {s: torch.as_tensor([vinfo["lookup"][v] for v in layouts[s][1]], device=dev) for s in layouts}
+    hand_rows = {s: torch.as_tensor(layouts[s][0], device=dev) for s in layouts}
+    bones = {s: torch.as_tensor(layouts[s][2], device=dev) for s in layouts}
+    hand_targets = {s: torch.as_tensor(targets.hands[s][:num_frames], device=dev) for s in layouts}
+
+    with torch.no_grad():
+        rest_joints, rest_verts = model.forward(torch.zeros(1, 55, 3, device=dev), torch.zeros(1, 3, device=dev))
+        hand_scale = {}
+        for s in layouts:
+            pts = torch.cat([rest_joints[0, hand_rows[s]], rest_verts[0, tip_rows[s]]], 0)
+            b = bones[s]
+            len_s = (pts[b[:, 1]] - pts[b[:, 0]]).norm(dim=-1).sum()
+            tb = hand_targets[s][0]
+            len_b = (tb[b[:, 1]] - tb[b[:, 0]]).norm(dim=-1).sum()
+            hand_scale[s] = float(len_s / len_b)
+
+    # BVH-driven fingertip contact flags, majority-filtered in time.
+    tip_contact = {s: torch.zeros(num_frames, 5, dtype=torch.bool, device=dev) for s in layouts}
+    if objects:
+        with torch.no_grad():
+            for s in layouts:
+                tips = hand_targets[s][:, 16:21]
+                for obj in objects:
+                    local = obj.to_local_cm(tips, slice(0, num_frames))
+                    tip_contact[s] |= obj.sdf.query(local).abs() < cfg.contact_tip_cm
+        if cfg.contact_filter_frames > 1:
+            k = cfg.contact_filter_frames
+            for s in layouts:
+                x = tip_contact[s].float().T[None]
+                avg = F.avg_pool1d(F.pad(x, (k // 2, k // 2), mode="replicate"), k, stride=1)
+                tip_contact[s] = avg[0].T > 0.5
+    digit3_rows = {s: [torch.as_tensor(vinfo["digit3"][s][d], device=dev) for d in DIGITS] for s in layouts}
+
+    # Stage-1 parameters (constants) and the low-frequency correction coefficients.
+    orient0 = torch.as_tensor(poses0[:, 0], device=dev)
+    body0 = torch.as_tensor(poses0[:, 1:22].reshape(num_frames, 63), device=dev)
+    lhand0 = torch.as_tensor(poses0[:, 25:40].reshape(num_frames, 45), device=dev)
+    rhand0 = torch.as_tensor(poses0[:, 40:55].reshape(num_frames, 45), device=dev)
+    trans0_t = torch.as_tensor(trans0, device=dev)
+    # MANO PCA (rows orthogonal, row norm = component std; training coefficients are whitened):
+    # whitened coefficients c = (pose - mean) @ B^T / |B_k|^2, Mahalanobis distance = |c|^2.
+    with np.load(model_path, allow_pickle=True) as m:
+        pca = {}
+        for s_, suffix in (("left", "l"), ("right", "r")):
+            comps = np.asarray(m[f"hands_components{suffix}"], dtype=np.float64)
+            proj = comps.T / (np.linalg.norm(comps, axis=1) ** 2)[None]  # (45, 45): h @ proj -> c
+            pca[s_] = (torch.as_tensor(np.asarray(m[f"hands_mean{suffix}"], dtype=np.float32), device=dev),
+                       torch.as_tensor(proj.astype(np.float32), device=dev))
+    basis = _bspline_basis(num_frames, cfg.basis_spacing, dev)  # (F, K)
+    num_coeff = basis.shape[1]
+    slots = {"orient": (0, 3), "body": (3, 66), "lhand": (66, 111), "rhand": (111, 156), "trans": (156, 159)}
+    coeff = torch.zeros(num_coeff, 159, device=dev, requires_grad=True)
+    param_mask = torch.ones(159, device=dev)  # which stage-1 parameters may receive a correction
+
+    def set_body_mode(mode: str):
+        param_mask.fill_(1.0)
+        if mode == "arms":
+            param_mask[0:3] = 0.0  # global orientation
+            param_mask[156:159] = 0.0  # translation
+            free_body = {16, 17, 18, 19, 20, 21}  # shoulders, elbows, wrists (SMPL-X joint ids)
+            for j in range(1, 22):
+                if j not in free_body:
+                    param_mask[3 + 3 * (j - 1): 3 + 3 * j] = 0.0
+        elif mode != "all":
+            raise ValueError("body_mode must be 'auto', 'arms' or 'all'")
+
+    def current(frames: slice):
+        delta = (basis[frames] @ coeff) * param_mask  # (n, 159)
+        o = orient0[frames] + delta[:, 0:3]
+        b = body0[frames] + delta[:, 3:66]
+        lh = lhand0[frames] + delta[:, 66:111]
+        rh = rhand0[frames] + delta[:, 111:156]
+        t = trans0_t[frames] + delta[:, 156:159]
+        n = o.shape[0]
+        pose = torch.cat([o[:, None], b.reshape(n, 21, 3), torch.zeros(n, 3, 3, device=dev),
+                          lh.reshape(n, 15, 3), rh.reshape(n, 15, 3)], dim=1)
+        return pose, t, (o, b, lh, rh)
+
+    chunks = [slice(s0, min(s0 + cfg.chunk, num_frames)) for s0 in range(0, num_frames, cfg.chunk)]
+
+    with torch.no_grad():
+        anchor = torch.empty(num_frames, 22, 3, device=dev)
+        for fr in chunks:
+            pose, t, _ = current(fr)
+            anchor[fr] = model.forward(pose, t)[0][:, :22]
+
+    def hand_terms(joints, verts, lh, rh, frames):
+        n = joints.shape[0]
+        loss_dir = joints.new_zeros(())
+        loss_pos = joints.new_zeros(())
+        for s in layouts:
+            pts = torch.cat([joints[:, hand_rows[s]], verts[:, tip_rows[s]]], 1)
+            tgt = hand_targets[s][frames]
+            b = bones[s]
+            u_s = F.normalize(pts[:, b[:, 1]] - pts[:, b[:, 0]], dim=-1)
+            u_t = F.normalize(tgt[:, b[:, 1]] - tgt[:, b[:, 0]], dim=-1)
+            loss_dir = loss_dir + (u_s - u_t).pow(2).sum(-1).sum(-1).sum()
+            rel_s = (pts[:, 1:] - pts[:, :1]) * 100.0
+            rel_t = (tgt[:, 1:] - tgt[:, :1]) * 100.0 * hand_scale[s]
+            loss_pos = loss_pos + (rel_s - rel_t).pow(2).sum(-1).sum()
+        prior = (lh - lhand0[frames]).pow(2).sum() + (rh - rhand0[frames]).pow(2).sum()
+        loss = cfg.w_hand_dir * loss_dir + cfg.w_hand_pos * loss_pos + cfg.w_hand_prior * prior
+        if cfg.w_hand_pca > 0:
+            for h, side in ((lh, "left"), (rh, "right")):
+                mean, proj = pca[side]
+                loss = loss + cfg.w_hand_pca * ((h - mean) @ proj).pow(2).sum()
+        return loss
+
+    def object_terms(verts, frames, normals=None):
+        """Penetration penalty and contact attraction (summed over frames); returns (loss, max depth)."""
+        loss = verts.new_zeros(())
+        depth = verts.new_zeros(verts.shape[0])
+        for oi, obj in enumerate(objects):
+            local = obj.to_local_cm(verts, frames)
+            sdf = obj.sdf.query(local)
+            pen = F.relu(cfg.pen_margin_cm - sdf)
+            loss = loss + cfg.w_pen * pen.pow(2).sum()
+            depth = torch.maximum(depth, F.relu(-sdf).max(dim=1).values)
+            if normals is not None and cfg.w_pen_normal > 0:
+                with torch.no_grad():
+                    weight = F.relu(cfg.pen_margin_cm - sdf)
+                    n_local = torch.einsum("bni,bij->bnj", normals, obj.rotation[frames])
+                loss = loss + cfg.w_pen_normal * (weight * (local * n_local).sum(-1)).sum()
+            # body contact: vertices currently within the band are pulled onto the surface
+            # (the B-spline parametrisation already prevents frame-to-frame flicker)
+            with torch.no_grad():
+                band = (sdf > 0) & (sdf < cfg.contact_band_cm)
+            loss = loss + cfg.w_contact_body * (sdf * band).pow(2).sum()
+            for s in layouts:
+                flags = tip_contact[s][frames]
+                for k in range(5):
+                    rows = digit3_rows[s][k]
+                    if rows.numel() == 0 or not flags[:, k].any():
+                        continue
+                    d = sdf[:, rows][flags[:, k]]
+                    loss = loss + cfg.w_contact_tip * F.relu(d - cfg.contact_target_cm).pow(2).sum()
+        return loss, depth
+
+    def hand_dir_error(joints, verts, frames):
+        errs = []
+        for s in layouts:
+            pts = torch.cat([joints[:, hand_rows[s]], verts[:, tip_rows[s]]], 1)
+            tgt = hand_targets[s][frames]
+            b = bones[s]
+            u_s = F.normalize(pts[:, b[:, 1]] - pts[:, b[:, 0]], dim=-1)
+            u_t = F.normalize(tgt[:, b[:, 1]] - tgt[:, b[:, 0]], dim=-1)
+            errs.append(torch.rad2deg(torch.acos((u_s * u_t).sum(-1).clamp(-1, 1))).mean(1))
+        return torch.stack(errs, 1).mean(1)
+
+    def tip_distance(verts, frames):
+        if not objects:
+            return verts.new_full((verts.shape[0],), float("nan"))
+        out = verts.new_zeros(verts.shape[0])
+        cnt = verts.new_zeros(verts.shape[0])
+        for obj in objects:
+            sdf = obj.sdf.query(obj.to_local_cm(verts, frames))
+            for s in layouts:
+                flags = tip_contact[s][frames].float()
+                out = out + (sdf[:, tip_rows[s]].abs() * flags).sum(1)
+                cnt = cnt + flags.sum(1)
+        return torch.where(cnt > 0, out / cnt.clamp(min=1), verts.new_full((verts.shape[0],), float("nan")))
+
+    def all_points(joints, verts):
+        return torch.cat([joints[:, :22], joints[:, 25:55], verts[:, tip_rows["left"]], verts[:, tip_rows["right"]]], 1)
+
+    body_rows = torch.as_tensor(np.flatnonzero(~vinfo["hand_mask"]), device=dev)
+
+    def body_depth(verts, frames):
+        """Max penetration depth (cm) per frame over non-hand vertices."""
+        depth = verts.new_zeros(verts.shape[0])
+        for obj in objects:
+            sdf = obj.sdf.query(obj.to_local_cm(verts[:, body_rows], frames))
+            depth = torch.maximum(depth, F.relu(-sdf).max(dim=1).values)
+        return depth
+
+    def evaluate():
+        """No-grad diagnostics over the whole clip."""
+        dirs, depths, bdepths, tipd, pts = [], [], [], [], []
+        with torch.no_grad():
+            for fr in chunks:
+                pose, t, _ = current(fr)
+                j, v = model.forward(pose, t)
+                dirs.append(hand_dir_error(j, v, fr))
+                pts.append(all_points(j, v))
+                if objects:
+                    depths.append(object_terms(v, fr)[1])
+                    bdepths.append(body_depth(v, fr))
+                    tipd.append(tip_distance(v, fr))
+        p = torch.cat(pts) * 1000.0
+        accel = (p[2:] - 2 * p[1:-1] + p[:-2]).norm(dim=-1).mean(1)
+        return {"dir": torch.cat(dirs), "depth": torch.cat(depths) if depths else None,
+                "body_depth": torch.cat(bdepths) if bdepths else None,
+                "tipd": torch.cat(tipd) if tipd else None, "accel": accel, "points": torch.cat(pts)}
+
+    before = evaluate()
+    body_mode = cfg.body_mode
+    if body_mode == "auto":
+        frac = float((before["body_depth"] > 1.0).float().mean()) if before["body_depth"] is not None else 0.0
+        body_mode = "all" if frac > cfg.body_contact_frac else "arms"
+    set_body_mode(body_mode)
+
+    opt = torch.optim.Adam([coeff], lr=cfg.lr_full)
+    sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, cfg.iters_full, eta_min=cfg.lr_full * cfg.lr_final_ratio)
+    iterator: Any = range(cfg.iters_full)
+    if progress:
+        from tqdm import tqdm
+        iterator = tqdm(iterator, desc="hoi-refine", leave=False)
+    for _ in iterator:
+        opt.zero_grad(set_to_none=True)
+        for fr in chunks:
+            pose, t, (o, b, lh, rh) = current(fr)
+            j, v, nrm = model.forward_with_normals(pose, t)
+            loss = hand_terms(j, v, lh, rh, fr)
+            loss = loss + cfg.w_joint_anchor * ((j[:, :22] - anchor[fr]) * 100.0).pow(2).sum(-1).sum()
+            loss = loss + cfg.w_pose_prior * ((b - body0[fr]).pow(2).sum() + (o - orient0[fr]).pow(2).sum())
+            if cfg.w_accel > 0:
+                loss = loss + cfg.w_accel * _accel(all_points(j, v) * 100.0, None, None)
+            if cfg.w_corr_accel > 0:
+                corr_pts = (all_points(j, v) - before["points"][fr]) * 100.0
+                loss = loss + cfg.w_corr_accel * _accel(corr_pts, None, None)
+            if objects:
+                loss = loss + object_terms(v, fr, nrm)[0]
+            (loss / num_frames).backward()
+        opt.step()
+        sched.step()
+
+    after = evaluate()
+    with torch.no_grad():
+        poses = torch.cat([current(fr)[0] for fr in chunks]).cpu().numpy().reshape(num_frames, 165)
+        trans_np = torch.cat([current(fr)[1] for fr in chunks]).cpu().numpy()
+
+    output.parent.mkdir(parents=True, exist_ok=True)
+    tmp = output.with_name(f".{output.name}.tmp.npz")
+    np.savez_compressed(
+        tmp,
+        poses=poses.astype(np.float32),
+        trans=trans_np.astype(np.float32),
+        betas=betas,
+        gender=np.asarray("neutral"),
+        mocap_framerate=np.asarray(framerate, dtype=np.float32),
+        tip_contact=torch.cat([tip_contact["left"], tip_contact["right"]], 1).cpu().numpy(),
+    )
+    tmp.replace(output)
+
+    def summary(x):
+        if x is None:
+            return None
+        x = x.cpu().numpy()
+        return {"mean": float(x.mean()), "max": float(x.max()), "p95": float(np.percentile(x, 95))}
+
+    def nanmean(x):
+        return None if x is None else float(np.nanmean(x.cpu().numpy()))
+
+    dev_cm = (after["points"] - before["points"]).norm(dim=-1) * 100.0  # (F, 62) joints+fingers+tips
+    groups = {"head": [15], "neck": [12], "spine": [3, 6, 9], "pelvis": [0], "legs": [1, 2, 4, 5, 7, 8],
+              "shoulders": [16, 17], "elbows": [18, 19], "wrists": [20, 21],
+              "fingers": list(range(22, 52)), "tips": list(range(52, 62))}
+    deviation = {k: {"mean": float(dev_cm[:, idx].mean()), "max": float(dev_cm[:, idx].max())} for k, idx in groups.items()}
+    corr = (after["points"] - before["points"]) * 1000.0
+    corr_speed = (corr[1:] - corr[:-1]).norm(dim=-1).max(dim=1).values  # mm per frame, max over points
+    stats: dict[str, Any] = {
+        "frames": num_frames,
+        "body_mode": body_mode,
+        "body_contact_frame_frac_before": float((before["body_depth"] > 1.0).float().mean()) if before["body_depth"] is not None else 0.0,
+        "deviation_cm": deviation,
+        "correction_speed_mm_per_frame": {"max": float(corr_speed.max()), "p99": float(np.percentile(corr_speed.cpu().numpy(), 99))},
+        "objects": [o.object_id for o in objects],
+        "hand_scale": hand_scale,
+        "basis_coefficients": int(num_coeff),
+        "tip_contact_frames": {s: int(tip_contact[s].any(1).sum()) for s in layouts},
+        "hand_dir_error_deg_before": summary(before["dir"]),
+        "hand_dir_error_deg_after": summary(after["dir"]),
+        "penetration_cm_before": summary(before["depth"]),
+        "penetration_cm_after": summary(after["depth"]),
+        "frames_penetrating_gt_1cm_before": int((before["depth"] > 1.0).sum()) if before["depth"] is not None else 0,
+        "frames_penetrating_gt_1cm_after": int((after["depth"] > 1.0).sum()) if after["depth"] is not None else 0,
+        "tip_contact_distance_cm_before": nanmean(before["tipd"]),
+        "tip_contact_distance_cm_after": nanmean(after["tipd"]),
+        "joint_accel_mm_before": summary(before["accel"]),
+        "joint_accel_mm_after": summary(after["accel"]),
+        "body_drift_cm_mean": float(np.linalg.norm(trans_np - trans0, axis=-1).mean() * 100.0),
+        "seconds": time.time() - t_start,
+    }
+    if stats_path is not None:
+        stats_path.parent.mkdir(parents=True, exist_ok=True)
+        stats_path.write_text(json.dumps(stats, indent=1))
+    return stats
