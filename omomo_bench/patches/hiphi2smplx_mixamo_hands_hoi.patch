+"""Command-line entry point for stage-2 HOI refinement."""
+
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+
+from .hoi_refine import RefineConfig, refine_package
+
+
+def build_parser() -> argparse.ArgumentParser:
+    """Build the refinement CLI parser."""
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--package", type=Path, required=True, help="HiPHI motion package directory")
+    p.add_argument("--stage1", type=Path, required=True, help="stage-1 SMPL-X NPZ from hiphi2smplx")
+    p.add_argument("--output", type=Path, required=True)
+    p.add_argument("--model-path", type=Path, required=True)
+    p.add_argument("--repo-root", type=Path, required=True, help="HiPHI root containing object_meshes/")
+    p.add_argument("--sdf-cache", type=Path)
+    p.add_argument("--stats", type=Path, help="write refinement statistics JSON here")
+    p.add_argument("--device", default="cuda:0")
+    p.add_argument("--overwrite", action="store_true")
+    p.add_argument("--progress", action="store_true")
+    for name, default in RefineConfig.__dataclass_fields__.items():
+        kind = type(default.default)
+        p.add_argument(f"--{name.replace('_', '-')}", type=kind, default=default.default)
+    return p
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Run one refinement."""
+    args = build_parser().parse_args(argv)
+    if args.output.exists() and not args.overwrite:
+        raise FileExistsError(f"{args.output} exists; pass --overwrite")
+    cfg = RefineConfig(**{k: getattr(args, k) for k in RefineConfig.__dataclass_fields__})
+    stats = refine_package(
+        args.package.resolve(), args.stage1.resolve(), args.model_path.resolve(), args.repo_root.resolve(),
+        args.output.resolve(), config=cfg, device=args.device, sdf_cache=args.sdf_cache,
+        stats_path=args.stats, progress=args.progress,
+    )
+    print(f"saved {args.output}  hand_dir_err {stats['hand_dir_error_deg_before']['mean']:.1f}->"
+          f"{stats['hand_dir_error_deg_after']['mean']:.1f} deg  "
+          f"pen {stats['penetration_cm_before']}->{stats['penetration_cm_after']}  {stats['seconds']:.0f}s")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
