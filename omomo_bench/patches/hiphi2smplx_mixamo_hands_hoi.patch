diff --git a/src/hiphi2smplx/hand_ik.py b/src/hiphi2smplx/hand_ik.py
new file mode 100644
index 0000000..75a5885
--- /dev/null
+++ b/src/hiphi2smplx/hand_ik.py
@@ -0,0 +1,271 @@
+"""Sequential Mink differential IK for the SMPL-X hands (stage 1.5).
+
+After the 22-joint body IK, both hands are solved frame by frame with the same
+differential-IK machinery: a 16-ball-joint chain per hand (wrist + 15 finger
+joints) with one site per joint and one fingertip site per digit. Targets are
+rebuilt from the BVH finger *directions* with the shaped SMPL-X bone lengths,
+so bone-length mismatch between the HiPHI skeleton and SMPL-X cannot pull the
+chain apart. Each frame is warm-started from the previous solution, which
+gives temporally coherent finger motion without a batch smoothness term.
+"""
+
+from __future__ import annotations
+
+import xml.etree.ElementTree as ET
+from dataclasses import dataclass
+from pathlib import Path
+
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+from .hoi_refine import DIGITS, _TIP_VERTEX, _hand_point_layout
+from .kinematics import local_to_global_rotations
+from .skeleton import SMPLX_BODY_PARENTS, SMPLX_JOINT_NAMES
+
+_WRIST = {"left": 20, "right": 21}
+_ELBOW = {"left": 18, "right": 19}
+
+
+@dataclass(frozen=True)
+class HandIkConfig:
+    """Settings for the sequential hand IK.
+
+    Attributes:
+        iterations: Differential-IK iterations per frame (warm-started).
+        dt: Mink integration step.
+        damping: Levenberg-Marquardt damping.
+        joint_cost: Position cost of the 15 finger-joint sites.
+        tip_cost: Position cost of the 5 fingertip sites.
+        palm_cost: Position cost of the 5 metacarpal-end (digit1) sites, which
+            only orient the rigid SMPL-X palm towards the BVH palm.
+        wrist_posture_cost: Pull of the wrist rotation towards the body-IK wrist.
+        finger_posture_cost: Pull of finger rotations towards the posture reference.
+        posture_reference: ``"flat"`` (zero rotations) or ``"mean"`` (SMPL-X/MANO
+            ``hands_mean``, a relaxed slightly curled hand).
+        solver: qpsolvers backend.
+    """
+
+    iterations: int = 5
+    dt: float = 0.01
+    damping: float = 1e-3
+    joint_cost: float = 1.0
+    tip_cost: float = 2.0
+    palm_cost: float = 0.3
+    wrist_posture_cost: float = 0.5
+    finger_posture_cost: float = 0.002
+    solver: str = "daqp"
+    posture_reference: str = "flat"
+
+
+def hands_mean(model_path: Path) -> dict[str, np.ndarray]:
+    """Return the SMPL-X/MANO mean finger poses per side with shape ``(15, 3)``."""
+    with np.load(model_path, allow_pickle=True) as m:
+        return {"left": np.asarray(m["hands_meanl"], dtype=np.float32).reshape(15, 3),
+                "right": np.asarray(m["hands_meanr"], dtype=np.float32).reshape(15, 3)}
+
+
+def shaped_rest(model_path: Path, betas: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    """Return the shaped 55 rest joints and 10 fingertip vertices (metres)."""
+    with np.load(model_path, allow_pickle=True) as m:
+        v_template = np.asarray(m["v_template"], dtype=np.float64)
+        shapedirs = np.asarray(m["shapedirs"], dtype=np.float64)
+        regressor = m["J_regressor"]
+        if hasattr(regressor, "toarray"):
+            regressor = regressor.toarray()
+    b = np.asarray(betas, dtype=np.float64).reshape(-1)
+    v = v_template + np.einsum("vcn,n->vc", shapedirs[..., : b.size], b)
+    joints = np.asarray(regressor, dtype=np.float64) @ v
+    tips = np.asarray([[v[_TIP_VERTEX[s][d]] for d in DIGITS] for s in ("left", "right")]).reshape(10, 3)
+    return joints, tips
+
+
+def _hand_mjcf(side: str, rest_joints: np.ndarray, tips: np.ndarray) -> tuple[str, list[str], list[str]]:
+    """Build a 16-ball-joint hand model rooted at the wrist (wrist at the origin)."""
+    joint_ids, _, _ = _hand_point_layout(side)  # wrist + 15 finger joints (SMPL-X order)
+    names = [SMPLX_JOINT_NAMES[j] for j in joint_ids]
+    wrist = rest_joints[joint_ids[0]]
+    root = ET.Element("mujoco", model=f"hiphi2smplx_hand_{side}")
+    ET.SubElement(root, "compiler", angle="radian")
+    ET.SubElement(root, "option", gravity="0 0 0", timestep="1")
+    world = ET.SubElement(root, "worldbody")
+
+    def fmt(v):
+        return " ".join(f"{x:.6f}" for x in v)
+
+    def body(parent_node, name, offset):
+        b = ET.SubElement(parent_node, "body", name=name, pos=fmt(offset))
+        ET.SubElement(b, "inertial", pos="0 0 0", mass="0.001", diaginertia="0.000001 0.000001 0.000001")
+        ET.SubElement(b, "joint", name=f"{name}_joint", type="ball")
+        ET.SubElement(b, "site", name=f"{name}_site", pos="0 0 0", size="0.003")
+        return b
+
+    wrist_body = body(world, names[0], np.zeros(3))
+    tip_sites = []
+    side_index = 0 if side == "left" else 1
+    for k, digit in enumerate(DIGITS):
+        parent_node, parent_pos = wrist_body, wrist
+        for seg in (1, 2, 3):
+            name = f"{side}_{digit}{seg}"
+            pos = rest_joints[SMPLX_JOINT_NAMES.index(name)]
+            parent_node = body(parent_node, name, pos - parent_pos)
+            parent_pos = pos
+        tip_name = f"{side}_{digit}_tip"
+        ET.SubElement(parent_node, "site", name=f"{tip_name}_site", pos=fmt(tips[side_index * 5 + k] - parent_pos), size="0.003")
+        tip_sites.append(f"{tip_name}_site")
+    return ET.tostring(root, encoding="unicode"), names, tip_sites
+
+
+class MinkHandSolver:
+    """Sequential differential IK for one SMPL-X hand."""
+
+    def __init__(self, side: str, rest_joints: np.ndarray, tips: np.ndarray, config: HandIkConfig | None = None) -> None:
+        import mink
+        import mujoco as mj
+
+        self.mink, self.mj = mink, mj
+        self.cfg = HandIkConfig() if config is None else config
+        self.side = side
+        xml, self.joint_names, tip_sites = _hand_mjcf(side, rest_joints, tips)
+        self.model = mj.MjModel.from_xml_string(xml)
+        self.configuration = mink.Configuration(self.model)
+        self.joint_ids, _, bones = _hand_point_layout(side)
+        self.bones = np.asarray(bones)
+        # Shaped bone lengths of the 20 bones in the 21-point layout.
+        pts = np.concatenate([rest_joints[self.joint_ids], tips[0:5] if side == "left" else tips[5:10]])
+        self.bone_lengths = np.asarray([np.linalg.norm(pts[c] - pts[p]) for p, c in self.bones])
+        # 21 target points: wrist + 15 joints + 5 tips, matching _hand_point_layout.
+        site_names = [f"{n}_site" for n in self.joint_names] + tip_sites
+        self.site_ids = np.asarray([mj.mj_name2id(self.model, mj.mjtObj.mjOBJ_SITE, s) for s in site_names])
+        digit1 = {f"{side}_{d}1" for d in DIGITS}
+        costs = [0.0] + [self.cfg.palm_cost if n in digit1 else self.cfg.joint_cost for n in self.joint_names[1:]] \
+            + [self.cfg.tip_cost] * 5
+        # bones grouped per digit: (wrist->d1, d1->d2, d2->d3, d3->tip)
+        self.digit_chains = [self.bones[4 * k: 4 * k + 4] for k in range(5)]
+        self.digit_lengths = [self.bone_lengths[4 * k: 4 * k + 4] for k in range(5)]
+        self.tasks = [
+            mink.FrameTask(frame_name=s, frame_type="site", position_cost=c, orientation_cost=0.0, lm_damping=self.cfg.damping)
+            for s, c in zip(site_names[1:], costs[1:], strict=True)
+        ]
+        posture = np.full(self.model.nv, self.cfg.finger_posture_cost)
+        posture[:3] = self.cfg.wrist_posture_cost
+        self.posture_task = mink.PostureTask(self.model, cost=posture, lm_damping=self.cfg.damping)
+        self.qpos_adr = np.asarray([
+            self.model.jnt_qposadr[mj.mj_name2id(self.model, mj.mjtObj.mjOBJ_JOINT, f"{n}_joint")] for n in self.joint_names
+        ])
+
+    def _qpos(self, pose: np.ndarray) -> np.ndarray:
+        q = self.model.qpos0.copy()
+        quats = Rotation.from_rotvec(pose).as_quat(scalar_first=True)
+        for adr, quat in zip(self.qpos_adr, quats, strict=True):
+            q[adr:adr + 4] = quat
+        return q
+
+    def _pose(self, q: np.ndarray) -> np.ndarray:
+        return np.stack([Rotation.from_quat(q[a:a + 4], scalar_first=True).as_rotvec() for a in self.qpos_adr]).astype(np.float32)
+
+    def _directions(self, bvh_points_local: np.ndarray) -> np.ndarray:
+        """Unit BVH bone directions for the 20 bones (zero for degenerate bones)."""
+        d = bvh_points_local[self.bones[:, 1]] - bvh_points_local[self.bones[:, 0]]
+        n = np.linalg.norm(d, axis=-1, keepdims=True)
+        return np.where(n > 1e-8, d / np.maximum(n, 1e-8), 0.0)
+
+    def _targets(self, dirs: np.ndarray, current: np.ndarray) -> np.ndarray:
+        """Chain targets: palm ends from the wrist, finger segments from the current digit1."""
+        tgt = np.zeros((21, 3))
+        for k, (chain, lengths) in enumerate(zip(self.digit_chains, self.digit_lengths, strict=True)):
+            w, d1 = chain[0]
+            tgt[d1] = tgt[w] + lengths[0] * dirs[4 * k]
+            base = current[d1].copy()
+            for step, ((_, c), length) in enumerate(zip(chain[1:], lengths[1:], strict=True), start=1):
+                base = base + length * dirs[4 * k + step]
+                tgt[c] = base
+        return tgt
+
+    def solve(self, bvh_points_local: np.ndarray, init_pose: np.ndarray, reference_pose: np.ndarray) -> tuple[np.ndarray, float]:
+        """Solve one frame.
+
+        Args:
+            bvh_points_local: 21 BVH points (wrist, 15 joints, 5 tips) in the
+                wrist-parent (elbow) frame; only their bone directions are used.
+            init_pose: 16 axis-angle rotations (wrist first) for warm start.
+            reference_pose: Posture-task target (wrist from body IK, fingers flat).
+
+        Returns:
+            Solved 16 axis-angle rotations and the mean bone-direction error in radians.
+        """
+        dirs = self._directions(bvh_points_local)
+        self.configuration.update(q=self._qpos(init_pose))
+        self.posture_task.set_target(self._qpos(reference_pose))
+        for _ in range(self.cfg.iterations):
+            current = self.configuration.data.site_xpos[self.site_ids]
+            tgt = self._targets(dirs, current)
+            for task, t in zip(self.tasks, tgt[1:], strict=True):
+                task.set_target(self.mink.SE3.from_rotation_and_translation(self.mink.SO3.identity(), t))
+            v = self.mink.solve_ik(self.configuration, [*self.tasks, self.posture_task], self.cfg.dt, self.cfg.solver,
+                                   damping=self.cfg.damping, safety_break=False)
+            self.configuration.integrate_inplace(v, self.cfg.dt)
+            self.configuration.update()
+        pts = self.configuration.data.site_xpos[self.site_ids]
+        d = pts[self.bones[:, 1]] - pts[self.bones[:, 0]]
+        d /= np.maximum(np.linalg.norm(d, axis=-1, keepdims=True), 1e-8)
+        err = float(np.arccos(np.clip((d * dirs).sum(-1), -1.0, 1.0)).mean())
+        return self._pose(self.configuration.q), err
+
+
+def fit_hands(
+    body_poses: np.ndarray,
+    translations: np.ndarray,
+    body_joints: np.ndarray,
+    hand_targets: dict[str, np.ndarray],
+    betas: np.ndarray,
+    model_path: Path,
+    config: HandIkConfig | None = None,
+    progress: bool = False,
+) -> tuple[np.ndarray, dict[str, np.ndarray]]:
+    """Solve both hands for a whole clip.
+
+    Args:
+        body_poses: Stage-1 poses ``(F, 55, 3)``; wrist rotations are refined in place (copy).
+        translations: Stage-1 translations ``(F, 3)`` (unused except for API symmetry).
+        body_joints: Stage-1 fitted world body joints ``(F, 22, 3)``.
+        hand_targets: ``load_bvh_targets(...).hands``: side -> ``(F, 21, 3)`` world points.
+        betas: Shape used by the body IK.
+        model_path: SMPL-X NPZ.
+        config: Hand IK settings.
+        progress: Show a tqdm bar.
+
+    Returns:
+        Poses with wrists and fingers filled, and per-side per-frame mean bone-direction error (radians).
+    """
+    cfg = HandIkConfig() if config is None else config
+    poses = np.asarray(body_poses, dtype=np.float32).copy()
+    num_frames = len(poses)
+    rest, tips = shaped_rest(model_path, betas)
+    local = Rotation.from_rotvec(poses[:, :22].reshape(-1, 3)).as_matrix().reshape(num_frames, 22, 3, 3)
+    global_rot = local_to_global_rotations(local, SMPLX_BODY_PARENTS)  # (F, 22, 3, 3)
+    errors = {}
+    frames: object = range(num_frames)
+    if progress:
+        from tqdm import tqdm
+        frames = tqdm(frames, desc="mink-hands", leave=False)
+    solvers = {s: MinkHandSolver(s, rest, tips, cfg) for s in ("left", "right")}
+    if cfg.posture_reference == "mean":
+        finger_ref = hands_mean(model_path)
+    elif cfg.posture_reference == "flat":
+        finger_ref = {s: np.zeros((15, 3), np.float32) for s in solvers}
+    else:
+        raise ValueError("posture_reference must be 'flat' or 'mean'")
+    prev = {s: np.concatenate([poses[0, _WRIST[s]][None], finger_ref[s]]) for s in solvers}
+    err = {s: np.zeros(num_frames, np.float32) for s in solvers}
+    hand_slot = {"left": slice(25, 40), "right": slice(40, 55)}
+    for f in frames:
+        for s, solver in solvers.items():
+            r_elbow = global_rot[f, _ELBOW[s]]
+            wrist_world = body_joints[f, _WRIST[s]]
+            pts_local = (hand_targets[s][f] - wrist_world) @ r_elbow  # rows: R^T p
+            ref = np.concatenate([poses[f, _WRIST[s]][None], finger_ref[s]])
+            sol, err[s][f] = solver.solve(pts_local, prev[s], ref)
+            prev[s] = sol
+            poses[f, _WRIST[s]] = sol[0]
+            poses[f, hand_slot[s]] = sol[1:]
+    return poses, err
